{%- doc -%}
  Animation de livraison dans le panier.

  Un petit camion charge un colis à l'entrepôt, roule jusqu'à la maison et
  dépose le colis à la porte. Trois étapes se lisent en dessous, au même
  rythme : « En entrepôt », « Expédié », « Reçu ».

  Rendu depuis layout/theme.liquid : couvre le tiroir panier et la page panier.
  Le bloc est inséré au-dessus des totaux, dans chaque résumé de panier qui
  contient un bouton de commande. Le panier du thème se redessine après chaque
  modification : un MutationObserver réinsère le bloc quand il disparaît.

  Aucune promesse de délai : l'animation illustre le parcours du colis, sans
  date ni durée.

  Accessibilité : toute l'animation est neutralisée sous
  `prefers-reduced-motion`, et le SVG est décrit par un aria-label.
  Retrait : supprimer ce fichier et la ligne `render` dans le layout.
{%- enddoc -%}

<template id="ulveo-livraison-template">
  <ulveo-livraison class="ulveo-liv" data-ulveo-livraison>
    <p class="ulveo-liv__title">De notre entrepôt à votre porte</p>

    <svg
      class="ulveo-liv__scene"
      viewBox="0 0 320 92"
      role="img"
      aria-label="Un camion charge votre colis à l'entrepôt, l'expédie, puis le dépose à votre porte."
      focusable="false"
    >
      {%- comment -%} Route {%- endcomment -%}
      <rect x="0" y="80" width="320" height="10" rx="2" fill="#140a05" fill-opacity="0.10"/>
      <line x1="4" y1="85" x2="316" y2="85" stroke="#fff" stroke-width="1.2" stroke-dasharray="8 7" stroke-opacity="0.9"/>

      {%- comment -%} Entrepôt {%- endcomment -%}
      <g class="ulveo-liv__warehouse">
        <rect x="10" y="36" width="64" height="44" fill="#e3d5ce"/>
        <polygon points="6,38 42,16 78,38" fill="#512815"/>
        <rect x="12" y="38" width="60" height="3" fill="#140a05" fill-opacity="0.12"/>
        <rect x="26" y="52" width="32" height="28" fill="#140a05" fill-opacity="0.75"/>
        <g class="ulveo-liv__shutter">
          <rect x="26" y="52" width="32" height="28" fill="#a6603f"/>
          <line x1="26" y1="57" x2="58" y2="57" stroke="#7a462e" stroke-width="1"/>
          <line x1="26" y1="62" x2="58" y2="62" stroke="#7a462e" stroke-width="1"/>
          <line x1="26" y1="67" x2="58" y2="67" stroke="#7a462e" stroke-width="1"/>
          <line x1="26" y1="72" x2="58" y2="72" stroke="#7a462e" stroke-width="1"/>
          <line x1="26" y1="77" x2="58" y2="77" stroke="#7a462e" stroke-width="1"/>
        </g>
        <rect x="34" y="26" width="16" height="7" rx="1.5" fill="#f6f1ef"/>
        <rect x="37" y="28.5" width="10" height="2" rx="1" fill="#CB4A16"/>
      </g>

      {%- comment -%} Maison {%- endcomment -%}
      <g class="ulveo-liv__house">
        <rect x="258" y="48" width="46" height="32" fill="#fbf8f6" stroke="#512815" stroke-width="1.5"/>
        <polygon points="252,50 281,26 310,50" fill="#CB4A16"/>
        <rect x="292" y="30" width="6" height="12" fill="#7a462e"/>
        <rect x="276" y="60" width="12" height="20" rx="1.5" fill="#7a462e"/>
        <circle cx="285.5" cy="70.5" r="0.9" fill="#f5cca8"/>
        <rect x="263" y="56" width="9" height="9" rx="1" fill="#f5cca8"/>
        <line x1="267.5" y1="56" x2="267.5" y2="65" stroke="#fbf8f6" stroke-width="1"/>
        <line x1="263" y1="60.5" x2="272" y2="60.5" stroke="#fbf8f6" stroke-width="1"/>
      </g>

      {%- comment -%} Colis : entrepôt → camion, puis camion → porte {%- endcomment -%}
      <g transform="translate(0 0)">
        <g class="ulveo-liv__parcel ulveo-liv__parcel--load">
          <rect x="0" y="0" width="12" height="10" rx="1.5" fill="#d9a066"/>
          <rect x="5" y="0" width="2" height="10" fill="#b07a45"/>
        </g>
        <g class="ulveo-liv__parcel ulveo-liv__parcel--drop">
          <rect x="0" y="0" width="12" height="10" rx="1.5" fill="#d9a066"/>
          <rect x="5" y="0" width="2" height="10" fill="#b07a45"/>
        </g>
      </g>

      {%- comment -%} Coche de réception {%- endcomment -%}
      <g transform="translate(282 44)">
        <g class="ulveo-liv__check">
          <circle cx="0" cy="0" r="7" fill="#17803d"/>
          <polyline points="-3.2,0.2 -0.8,2.6 3.4,-2.2" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </g>
      </g>

      {%- comment -%} Camion (tourné vers la droite, roues posées sur la route) {%- endcomment -%}
      <g transform="translate(0 50)">
        <g class="ulveo-liv__truck">
          <g class="ulveo-liv__smoke">
            <circle class="ulveo-liv__puff" cx="-3" cy="24" r="2.4" fill="#140a05" fill-opacity="0.18"/>
            <circle class="ulveo-liv__puff ulveo-liv__puff--2" cx="-3" cy="24" r="2.4" fill="#140a05" fill-opacity="0.18"/>
          </g>
          <g class="ulveo-liv__body">
            <rect x="0" y="2" width="32" height="22" rx="2.5" fill="#7a462e"/>
            <rect x="0" y="15" width="32" height="3" fill="#CB4A16"/>
            <rect x="5" y="6" width="10" height="6" rx="1" fill="#f6f1ef" fill-opacity="0.9"/>
            <path d="M33 9 h9 l6 7 v8 h-15 z" fill="#512815"/>
            <path d="M35 11 h6 l4 5 h-10 z" fill="#e3d5ce"/>
            <rect x="45" y="19" width="3" height="2" rx="0.8" fill="#f5cca8"/>
            <rect x="-1" y="23" width="50" height="2.5" rx="1.2" fill="#140a05" fill-opacity="0.8"/>
          </g>
          <g class="ulveo-liv__wheel" transform="translate(10 26)">
            <g class="ulveo-liv__spin">
              <circle r="5" fill="#140a05"/>
              <circle r="2.2" fill="#e3d5ce"/>
              <rect x="-0.6" y="-4.2" width="1.2" height="2.4" fill="#e3d5ce"/>
            </g>
          </g>
          <g class="ulveo-liv__wheel" transform="translate(39 26)">
            <g class="ulveo-liv__spin">
              <circle r="5" fill="#140a05"/>
              <circle r="2.2" fill="#e3d5ce"/>
              <rect x="-0.6" y="-4.2" width="1.2" height="2.4" fill="#e3d5ce"/>
            </g>
          </g>
        </g>
      </g>
    </svg>

    <ol class="ulveo-liv__steps" aria-hidden="true">
      <li class="ulveo-liv__step ulveo-liv__step--1"><span class="ulveo-liv__dot"></span>En entrepôt</li>
      <li class="ulveo-liv__step ulveo-liv__step--2"><span class="ulveo-liv__dot"></span>Expédié</li>
      <li class="ulveo-liv__step ulveo-liv__step--3"><span class="ulveo-liv__dot"></span>Reçu</li>
      <li class="ulveo-liv__track"><span class="ulveo-liv__fill"></span></li>
    </ol>
  </ulveo-livraison>
</template>

<style>
  /* Toutes les animations partagent la même durée : chaque pourcentage
     correspond au même instant de l'histoire.
       0 – 24 %  : chargement du colis à l'entrepôt
      24 – 58 %  : trajet jusqu'à la maison
      58 – 90 %  : dépôt du colis et coche de réception
      80 – 100 % : le camion repart et revient à l'entrepôt */
  .ulveo-liv {
    --ulveo-liv-duration: 10s;
    --ulveo-liv-accent: #CB4A16;
    --ulveo-liv-ink: #140a05;

    display: block;
    width: 100%;
    box-sizing: border-box;
    padding: 12px 14px 10px;
    border: 1px solid rgb(20 10 5 / 0.08);
    border-radius: 12px;
    background: #fbf8f6;
    color: var(--ulveo-liv-ink);
    overflow: hidden;
  }

  .ulveo-liv__title {
    margin: 0 0 6px;
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0.01em;
    color: var(--ulveo-liv-ink);
  }

  .ulveo-liv__scene {
    display: block;
    width: 100%;
    height: auto;
    max-height: 110px;
    overflow: hidden;
  }

  .ulveo-liv__scene * {
    transform-box: fill-box;
  }

  /* ---------- Camion ---------------------------------------------------- */

  .ulveo-liv__truck {
    transform: translateX(78px);
    animation: ulveo-liv-truck var(--ulveo-liv-duration) infinite;
  }

  @keyframes ulveo-liv-truck {
    0%, 24% { transform: translateX(78px); opacity: 1; animation-timing-function: cubic-bezier(0.45, 0, 0.3, 1); }
    58%, 80% { transform: translateX(200px); opacity: 1; animation-timing-function: cubic-bezier(0.5, 0, 1, 1); }
    89% { transform: translateX(340px); opacity: 1; }
    89.5% { transform: translateX(340px); opacity: 0; }
    90% { transform: translateX(-60px); opacity: 0; animation-timing-function: cubic-bezier(0, 0, 0.3, 1); }
    91% { opacity: 1; }
    100% { transform: translateX(78px); opacity: 1; }
  }

  /* Le moteur tourne : la caisse vibre très légèrement. */
  .ulveo-liv__body {
    transform-origin: center bottom;
    animation: ulveo-liv-idle 0.35s ease-in-out infinite alternate;
  }

  @keyframes ulveo-liv-idle {
    from { transform: translateY(0); }
    to { transform: translateY(-0.6px); }
  }

  /* Les roues ne tournent que pendant les trajets. Les sauts de 360° sont
     invisibles : la boucle reste fluide. */
  .ulveo-liv__spin {
    transform-origin: center;
    animation: ulveo-liv-spin var(--ulveo-liv-duration) infinite;
  }

  @keyframes ulveo-liv-spin {
    0%, 24% { transform: rotate(0deg); animation-timing-function: cubic-bezier(0.45, 0, 0.3, 1); }
    58%, 80% { transform: rotate(1080deg); animation-timing-function: cubic-bezier(0.5, 0, 1, 1); }
    89%, 90% { transform: rotate(1800deg); animation-timing-function: cubic-bezier(0, 0, 0.3, 1); }
    100% { transform: rotate(2520deg); }
  }

  .ulveo-liv__puff {
    transform-origin: center;
    opacity: 0;
    animation: ulveo-liv-puff 1.1s ease-out infinite;
  }

  .ulveo-liv__puff--2 {
    animation-delay: 0.55s;
  }

  @keyframes ulveo-liv-puff {
    0% { transform: translate(0, 0) scale(0.6); opacity: 0.9; }
    100% { transform: translate(-9px, -5px) scale(1.8); opacity: 0; }
  }

  /* ---------- Entrepôt : le rideau s'ouvre pour sortir le colis --------- */

  .ulveo-liv__shutter {
    transform-origin: center top;
    animation: ulveo-liv-shutter var(--ulveo-liv-duration) infinite;
  }

  @keyframes ulveo-liv-shutter {
    0%, 1% { transform: scaleY(1); }
    6%, 20% { transform: scaleY(0.12); }
    25%, 100% { transform: scaleY(1); }
  }

  /* ---------- Colis ------------------------------------------------------ */

  .ulveo-liv__parcel {
    opacity: 0;
  }

  /* Sort de l'entrepôt, roule sur le quai puis saute à l'arrière du camion
     garé à x ≈ 78. */
  .ulveo-liv__parcel--load {
    animation: ulveo-liv-load var(--ulveo-liv-duration) infinite;
  }

  @keyframes ulveo-liv-load {
    0%, 5% { transform: translate(36px, 70px); opacity: 0; }
    7% { transform: translate(36px, 70px); opacity: 1; animation-timing-function: ease-in-out; }
    13% { transform: translate(62px, 70px); opacity: 1; animation-timing-function: ease-out; }
    16% { transform: translate(68px, 50px); opacity: 1; animation-timing-function: ease-in; }
    19% { transform: translate(80px, 58px); opacity: 1; }
    21%, 100% { transform: translate(82px, 58px); opacity: 0; }
  }

  /* Sort du toit de la caisse (camion garé à x ≈ 200) et saute jusqu'à la porte. */
  .ulveo-liv__parcel--drop {
    animation: ulveo-liv-drop var(--ulveo-liv-duration) infinite;
  }

  @keyframes ulveo-liv-drop {
    0%, 60% { transform: translate(214px, 52px); opacity: 0; }
    62% { transform: translate(214px, 52px); opacity: 1; animation-timing-function: ease-out; }
    66% { transform: translate(240px, 34px); opacity: 1; animation-timing-function: ease-in; }
    70% { transform: translate(262px, 70px); opacity: 1; }
    72% { transform: translate(262px, 68px); opacity: 1; }
    73%, 86% { transform: translate(262px, 70px); opacity: 1; }
    90%, 100% { transform: translate(262px, 70px); opacity: 0; }
  }

  /* ---------- Coche de réception ---------------------------------------- */

  .ulveo-liv__check {
    transform-origin: center;
    transform: scale(0);
    animation: ulveo-liv-check var(--ulveo-liv-duration) infinite;
  }

  @keyframes ulveo-liv-check {
    0%, 72% { transform: scale(0); opacity: 0; }
    76% { transform: scale(1.25); opacity: 1; }
    79%, 87% { transform: scale(1); opacity: 1; }
    91%, 100% { transform: scale(0); opacity: 0; }
  }

  /* ---------- Étapes ----------------------------------------------------- */

  .ulveo-liv__steps {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
  }

  .ulveo-liv__step {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
    font-size: 0.6875rem;
    line-height: 1.2;
    color: rgb(20 10 5 / 0.55);
    text-align: center;
  }

  .ulveo-liv__step--1 { align-items: flex-start; text-align: left; }
  .ulveo-liv__step--3 { align-items: flex-end; text-align: right; }

  .ulveo-liv__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #fbf8f6;
    box-shadow: inset 0 0 0 2px rgb(20 10 5 / 0.2);
  }

  /* La ligne relie les trois pastilles, de centre à centre. */
  .ulveo-liv__track {
    position: absolute;
    top: 4px;
    left: 5px;
    right: 5px;
    height: 2px;
    border-radius: 2px;
    background: rgb(20 10 5 / 0.12);
    overflow: hidden;
  }

  .ulveo-liv__fill {
    display: block;
    height: 100%;
    background: var(--ulveo-liv-accent);
    transform-origin: left center;
    transform: scaleX(0);
    animation: ulveo-liv-fill var(--ulveo-liv-duration) infinite;
  }

  @keyframes ulveo-liv-fill {
    0%, 22% { transform: scaleX(0); animation-timing-function: cubic-bezier(0.45, 0, 0.3, 1); }
    58% { transform: scaleX(0.5); }
    72%, 88% { transform: scaleX(1); }
    96%, 100% { transform: scaleX(0); }
  }

  .ulveo-liv__step--1 { animation: ulveo-liv-step-1 var(--ulveo-liv-duration) infinite; }
  .ulveo-liv__step--2 { animation: ulveo-liv-step-2 var(--ulveo-liv-duration) infinite; }
  .ulveo-liv__step--3 { animation: ulveo-liv-step-3 var(--ulveo-liv-duration) infinite; }

  .ulveo-liv__step--1 .ulveo-liv__dot { animation: ulveo-liv-dot-1 var(--ulveo-liv-duration) infinite; }
  .ulveo-liv__step--2 .ulveo-liv__dot { animation: ulveo-liv-dot-2 var(--ulveo-liv-duration) infinite; }
  .ulveo-liv__step--3 .ulveo-liv__dot { animation: ulveo-liv-dot-3 var(--ulveo-liv-duration) infinite; }

  /* Étape active : texte à pleine intensité. Étape franchie : pastille pleine. */
  @keyframes ulveo-liv-step-1 {
    0%, 24% { color: var(--ulveo-liv-ink); font-weight: 600; }
    26%, 100% { color: rgb(20 10 5 / 0.55); font-weight: 400; }
  }

  @keyframes ulveo-liv-step-2 {
    0%, 24% { color: rgb(20 10 5 / 0.55); font-weight: 400; }
    26%, 62% { color: var(--ulveo-liv-ink); font-weight: 600; }
    64%, 100% { color: rgb(20 10 5 / 0.55); font-weight: 400; }
  }

  @keyframes ulveo-liv-step-3 {
    0%, 70% { color: rgb(20 10 5 / 0.55); font-weight: 400; }
    72%, 90% { color: var(--ulveo-liv-ink); font-weight: 600; }
    94%, 100% { color: rgb(20 10 5 / 0.55); font-weight: 400; }
  }

  @keyframes ulveo-liv-dot-1 {
    0%, 90% { background: var(--ulveo-liv-accent); box-shadow: inset 0 0 0 2px var(--ulveo-liv-accent), 0 0 0 3px rgb(203 74 22 / 0.18); }
    96%, 100% { background: var(--ulveo-liv-accent); box-shadow: inset 0 0 0 2px var(--ulveo-liv-accent); }
  }

  @keyframes ulveo-liv-dot-2 {
    0%, 22% { background: #fbf8f6; box-shadow: inset 0 0 0 2px rgb(20 10 5 / 0.2); }
    26%, 88% { background: var(--ulveo-liv-accent); box-shadow: inset 0 0 0 2px var(--ulveo-liv-accent), 0 0 0 3px rgb(203 74 22 / 0.18); }
    96%, 100% { background: #fbf8f6; box-shadow: inset 0 0 0 2px rgb(20 10 5 / 0.2); }
  }

  @keyframes ulveo-liv-dot-3 {
    0%, 70% { background: #fbf8f6; box-shadow: inset 0 0 0 2px rgb(20 10 5 / 0.2); }
    73%, 88% { background: #17803d; box-shadow: inset 0 0 0 2px #17803d, 0 0 0 3px rgb(23 128 61 / 0.18); }
    96%, 100% { background: #fbf8f6; box-shadow: inset 0 0 0 2px rgb(20 10 5 / 0.2); }
  }

  /* ---------- Mouvement réduit ------------------------------------------ */

  /* Image fixe : le camion est garé devant la maison, colis livré. */
  @media (prefers-reduced-motion: reduce) {
    .ulveo-liv * {
      animation: none !important;
    }

    .ulveo-liv__truck { transform: translateX(200px); }
    .ulveo-liv__shutter { transform: scaleY(1); }
    .ulveo-liv__parcel--drop { transform: translate(262px, 70px); opacity: 1; }
    .ulveo-liv__check { transform: scale(1); opacity: 1; }
    .ulveo-liv__fill { transform: scaleX(1); }
    .ulveo-liv__dot { background: var(--ulveo-liv-accent); box-shadow: inset 0 0 0 2px var(--ulveo-liv-accent); }
    .ulveo-liv__step--3 .ulveo-liv__dot { background: #17803d; box-shadow: inset 0 0 0 2px #17803d; }
    .ulveo-liv__step { color: var(--ulveo-liv-ink); }
  }
</style>

<script>
  (function () {
    var template = document.getElementById('ulveo-livraison-template');
    if (!template || !template.content) return;

    var scheduled = false;

    /* Un bloc par résumé de panier, placé au-dessus des totaux. Le bouton de
       commande sert d'ancre : il est présent dans le tiroir comme sur la page
       panier, et désactivé quand le panier est vide. */
    function ensure() {
      scheduled = false;

      var buttons = document.querySelectorAll('button[name="checkout"]');
      Array.prototype.forEach.call(buttons, function (button) {
        var ctas = button.closest('.cart__ctas') || button.parentElement;
        var summary = ctas && ctas.parentElement;
        if (!summary) return;

        var existing = summary.querySelector(':scope > [data-ulveo-livraison]');

        if (button.disabled) {
          if (existing) existing.remove();
          return;
        }

        if (existing) return;

        var anchor = summary.querySelector(':scope > .cart-totals') || ctas;
        summary.insertBefore(template.content.firstElementChild.cloneNode(true), anchor);
      });
    }

    function schedule() {
      if (scheduled) return;
      scheduled = true;
      window.requestAnimationFrame(ensure);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', ensure);
    } else {
      ensure();
    }

    /* Le panier est redessiné à chaque ajout ou changement de quantité. */
    if ('MutationObserver' in window) {
      new MutationObserver(schedule).observe(document.body, {
        childList: true,
        subtree: true,
        attributes: true,
        attributeFilter: ['disabled']
      });
    } else {
      setInterval(ensure, 1200);
    }
  })();
</script>
