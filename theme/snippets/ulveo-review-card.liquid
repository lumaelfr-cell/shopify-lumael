{%- doc -%}
  Ulvéo — carte d'un avis client (page « Avis clients »).

  Rend un <li> destiné à la grille de la section `ulveo-reviews`. Les
  attributs data-* servent au filtre, au tri et à la visionneuse photo
  (assets/ulveo-reviews.js) ; sans JavaScript, la carte reste complète.

  @param {object} block - Bloc « Avis » de la section
  @param {number} index - Position de l'avis dans la liste (0 = premier)
  @param {string} verified_label - Libellé de la mention d'achat vérifié
{%- enddoc -%}

{%- liquid
  assign r = block.settings

  assign ulveo_name = r.name | strip
  if ulveo_name == blank
    assign ulveo_name = 'Anonyme'
  endif
  assign ulveo_initial = ulveo_name | slice: 0 | upcase

  assign ulveo_rating = r.rating | default: 5 | at_least: 1 | at_most: 5

  assign ulveo_has_photo = false
  if r.image != blank
    assign ulveo_has_photo = true
  endif

  # Date facultative, saisie en JJ/MM/AAAA (ou AAAA-MM-JJ). Une valeur
  # illisible est ignorée plutôt qu'affichée de travers.
  assign ulveo_date_iso = ''
  assign ulveo_date_label = ''
  assign ulveo_date_raw = r.date | strip
  if ulveo_date_raw != blank
    if ulveo_date_raw contains '/'
      assign ulveo_parts = ulveo_date_raw | split: '/'
      if ulveo_parts.size == 3
        assign ulveo_date_raw = ulveo_parts[2] | append: '-' | append: ulveo_parts[1] | append: '-' | append: ulveo_parts[0]
      endif
    endif
    assign ulveo_date_try = ulveo_date_raw | date: '%Y-%m-%d'
    assign ulveo_sep_1 = ulveo_date_try | slice: 4, 1
    assign ulveo_sep_2 = ulveo_date_try | slice: 7, 1
    if ulveo_date_try.size == 10 and ulveo_sep_1 == '-' and ulveo_sep_2 == '-'
      assign ulveo_date_iso = ulveo_date_try
      assign ulveo_months = 'janv.,févr.,mars,avr.,mai,juin,juil.,août,sept.,oct.,nov.,déc.' | split: ','
      assign ulveo_month_index = ulveo_date_iso | slice: 5, 2 | plus: 0 | minus: 1
      assign ulveo_day = ulveo_date_iso | slice: 8, 2 | plus: 0
      assign ulveo_year = ulveo_date_iso | slice: 0, 4
      assign ulveo_date_label = ulveo_day | append: ' ' | append: ulveo_months[ulveo_month_index] | append: ' ' | append: ulveo_year
    endif
  endif

  # Texte alternatif : celui saisi dans le bloc, sinon celui de l'image dans
  # Contenu › Fichiers, sinon une description neutre. Un nom de fichier
  # (« IMG_4777.jpg ») n'est jamais un texte alternatif acceptable.
  if ulveo_has_photo
    assign ulveo_alt = r.image_alt | strip
    if ulveo_alt == blank
      assign ulveo_alt = r.image.alt | strip
    endif
    assign ulveo_alt_lower = ulveo_alt | downcase
    if ulveo_alt_lower contains '.jpg' or ulveo_alt_lower contains '.jpeg' or ulveo_alt_lower contains '.png' or ulveo_alt_lower contains '.webp' or ulveo_alt_lower contains '.heic'
      assign ulveo_alt = ''
    endif
    if ulveo_alt == blank
      assign ulveo_alt = 'Photo publiée par ' | append: ulveo_name | append: ' avec son avis'
    endif
    assign ulveo_label = 'Agrandir la photo de ' | append: ulveo_name

    # Visionneuse : on ne déclare que des largeurs réellement disponibles,
    # sinon le navigateur afficherait une petite photo en taille réduite.
    assign ulveo_full_srcset = ''
    assign ulveo_full_widths = '900,1300,1800' | split: ','
    for ulveo_w in ulveo_full_widths
      assign ulveo_w_num = ulveo_w | plus: 0
      if ulveo_w_num < r.image.width
        assign ulveo_url = r.image | image_url: width: ulveo_w_num
        assign ulveo_full_srcset = ulveo_full_srcset | append: ', ' | append: ulveo_url | append: ' ' | append: ulveo_w_num | append: 'w'
      endif
    endfor
    assign ulveo_full_max = r.image.width | at_most: 2400
    assign ulveo_url = r.image | image_url: width: ulveo_full_max
    assign ulveo_full_srcset = ulveo_full_srcset | append: ', ' | append: ulveo_url | append: ' ' | append: ulveo_full_max | append: 'w' | remove_first: ', '

    assign ulveo_loading = 'lazy'
    if index == 0
      assign ulveo_loading = 'eager'
    endif
  endif
-%}

<li
  class="ulveo-review"
  data-review
  data-rating="{{ ulveo_rating }}"
  data-photo="{{ ulveo_has_photo }}"
  data-date="{{ ulveo_date_iso }}"
  {{ block.shopify_attributes }}
>
  <article
    class="ulveo-review__card {% if ulveo_has_photo %}ulveo-review__card--photo{% else %}ulveo-review__card--text{% endif %}"
    aria-labelledby="UlveoReviewName-{{ block.id }}"
  >
    {%- if ulveo_has_photo -%}
      <button
        type="button"
        class="ulveo-review__media"
        aria-haspopup="dialog"
        aria-label="{{ ulveo_label | escape }}"
        data-lightbox-open
        data-src="{{ r.image | image_url: width: ulveo_full_max }}"
        data-srcset="{{ ulveo_full_srcset }}"
        data-width="{{ r.image.width }}"
        data-height="{{ r.image.height }}"
        data-alt="{{ ulveo_alt | escape }}"
        data-label="{{ 'Photo publiée par ' | append: ulveo_name | escape }}"
      >
        {{
          r.image
          | image_url: width: 1080
          | image_tag:
            widths: '360, 480, 640, 800, 1080',
            sizes: '(min-width: 1100px) 360px, (min-width: 750px) calc(50vw - 72px), calc(100vw - 52px)',
            loading: ulveo_loading,
            alt: ulveo_alt,
            class: 'ulveo-review__img'
        }}
        <span class="ulveo-review__zoom" aria-hidden="true">
          <svg viewBox="0 0 20 20" focusable="false">
            <path d="M12.5 3.5h4v4M16.5 3.5l-5 5M7.5 16.5h-4v-4M3.5 16.5l5-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </button>
    {%- endif -%}

    <div class="ulveo-review__body">
      <div class="ulveo-review__rating">
        {% render 'ulveo-stars', rating: ulveo_rating %}
        <span class="visually-hidden">Note : {{ ulveo_rating }} sur 5.</span>
        {%- if ulveo_date_iso != blank -%}
          <time class="ulveo-review__date" datetime="{{ ulveo_date_iso }}">{{ ulveo_date_label }}</time>
        {%- endif -%}
      </div>

      <div class="ulveo-review__author">
        <span class="ulveo-review__avatar" aria-hidden="true">{{ ulveo_initial | escape }}</span>
        <div class="ulveo-review__identity">
          <h3 class="ulveo-review__name" id="UlveoReviewName-{{ block.id }}">{{ ulveo_name | escape }}</h3>
          {%- if r.city != blank or r.verified -%}
            <p class="ulveo-review__details">
              {%- if r.city != blank -%}
                <span>{{ r.city | strip | escape }}</span>
              {%- endif -%}
              {%- if r.verified -%}
                <span class="ulveo-review__verified">
                  <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                    <path d="M8 1.2l1.64 1.2 2.03-.02.63 1.93 1.64 1.2-.62 1.94.62 1.93-1.64 1.2-.63 1.93-2.03-.01L8 14.8l-1.64-1.2-2.03.01-.63-1.93-1.64-1.2.62-1.93-.62-1.94 1.64-1.2.63-1.93 2.03.02L8 1.2z" fill="currentColor"/>
                    <path d="M5.4 8.2l1.8 1.8 3.4-3.6" fill="none" stroke="#fff" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  {{ verified_label | default: 'Achat vérifié' | escape }}
                </span>
              {%- endif -%}
            </p>
          {%- endif -%}
        </div>
      </div>

      {%- if r.text != blank -%}
        <blockquote class="ulveo-review__text">{{ r.text }}</blockquote>
      {%- endif -%}
    </div>
  </article>
</li>
