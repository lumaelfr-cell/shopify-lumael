{%- comment -%}
  Ulvéo — appel à l'action de fin de page « Avis clients ».

  Deux intentions, deux poids visuels : découvrir la scelleuse (bouton
  principal) et, plus discrètement, partager son propre avis. Le second
  bouton pointe vers une page existante (par défaut la page Contact) :
  aucune fonctionnalité fictive. Il se branche sur une application d'avis
  en changeant simplement son lien.
{%- endcomment -%}

{{ 'ulveo-reviews.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign uid = section.id | handle
  assign reassurance = section.settings.reassurance | split: '·'
  assign has_share = false
  if section.settings.share_label != blank and section.settings.share_link != blank
    assign has_share = true
  endif
-%}

<div
  class="ulveo-reviews-cta color-{{ section.settings.color_scheme }}"
  style="--uvr-pt: {{ section.settings.padding_top }}px; --uvr-pb: {{ section.settings.padding_bottom }}px; --uvr-panel: {{ section.settings.panel_color }};"
>
  <div class="ulveo-reviews__container">
    <div class="ulveo-reviews-cta__panel{% unless has_share %} ulveo-reviews-cta__panel--solo{% endunless %}">
      <section class="ulveo-reviews-cta__main" aria-labelledby="UlveoCta-{{ uid }}">
        {%- if section.settings.eyebrow != blank -%}
          <p class="ulveo-reviews__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="ulveo-reviews-cta__heading" id="UlveoCta-{{ uid }}">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}
          <div class="ulveo-reviews-cta__text">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
          <a class="button ulveo-reviews-cta__button" href="{{ section.settings.button_link }}">
            {{- section.settings.button_label | escape -}}
            <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M4 10h11.5M11 5.5l4.5 4.5-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.reassurance != blank -%}
          <ul class="ulveo-reviews-cta__assurances" role="list">
            {%- for item in reassurance -%}
              {%- assign item_text = item | strip -%}
              {%- if item_text != blank -%}
                <li>
                  <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M3.5 8.5l3 3 6-7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {{ item_text | escape }}
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </section>

      {%- if has_share -%}
        <div class="ulveo-reviews-cta__rule" aria-hidden="true"></div>
        <section class="ulveo-reviews-cta__share" aria-labelledby="UlveoShare-{{ uid }}">
          <h3 class="ulveo-reviews-cta__share-heading" id="UlveoShare-{{ uid }}">{{ section.settings.share_heading | escape }}</h3>
          {%- if section.settings.share_text != blank -%}
            <div class="ulveo-reviews-cta__share-text">{{ section.settings.share_text }}</div>
          {%- endif -%}
          <a class="button-secondary ulveo-reviews-cta__share-button" href="{{ section.settings.share_link }}">
            {{- section.settings.share_label | escape -}}
          </a>
        </section>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Avis — appel à l'action",
  "tag": "div",
  "class": "ulveo-reviews-cta-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Découvrir le produit"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Surtitre",
      "default": "À votre tour"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Rejoignez nos clients"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte",
      "default": "<p>Scellez n'importe quel sachet en 3 secondes et gardez ce que vous venez d'acheter frais plus longtemps.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texte du bouton",
      "default": "Découvrir la scelleuse"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Lien du bouton"
    },
    {
      "type": "text",
      "id": "reassurance",
      "label": "Engagements",
      "info": "Séparez les éléments par « · ». Laissez vide pour les masquer.",
      "default": "Garantie légale 2 ans · Livraison rapide · 14 jours pour changer d’avis"
    },
    {
      "type": "header",
      "content": "Partager un avis"
    },
    {
      "type": "text",
      "id": "share_heading",
      "label": "Titre",
      "default": "Déjà client Ulvéo ?"
    },
    {
      "type": "richtext",
      "id": "share_text",
      "label": "Texte",
      "default": "<p>Racontez-nous comment vous utilisez votre scelleuse : chaque retour nous aide à progresser.</p>"
    },
    {
      "type": "text",
      "id": "share_label",
      "label": "Texte du bouton",
      "default": "Partager mon avis"
    },
    {
      "type": "url",
      "id": "share_link",
      "label": "Lien du bouton",
      "info": "Page Contact par défaut. Remplacez-le par le formulaire de votre application d'avis quand vous en installerez une. Laissez vide pour masquer ce bloc."
    },
    {
      "type": "header",
      "content": "Mise en page"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Jeu de couleurs de la section",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "panel_color",
      "label": "Fond du bandeau",
      "default": "#f1ebeb"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge haute",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge basse",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Avis — appel à l'action"
    }
  ]
}
{% endschema %}
