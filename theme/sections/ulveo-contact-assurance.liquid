{%- comment -%}
  Ulvéo — bandeau de réassurance de fin de page Contact.
  Un titre, un texte, et jusqu'à quatre engagements (blocs). N'y inscrire
  que des engagements réellement tenus par la boutique.
{%- endcomment -%}

{{ 'ulveo-contact.css' | asset_url | stylesheet_tag }}

{%- assign uid = section.id | handle -%}

<div
  class="ulveo-contact-assurance color-{{ section.settings.color_scheme }}"
  style="--uct-pt: {{ section.settings.padding_top }}px; --uct-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="ulveo-contact__container">
    <section class="ulveo-contact-assurance__panel" aria-labelledby="UlveoAssurance-{{ uid }}">
      <div class="ulveo-contact-assurance__head">
        {%- if section.settings.eyebrow != blank -%}
          <p class="ulveo-contact__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="ulveo-contact__h2" id="UlveoAssurance-{{ uid }}">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}
          <div class="ulveo-contact-assurance__text">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <ul class="ulveo-contact-assurance__list" role="list">
          {%- for block in section.blocks -%}
            <li class="ulveo-contact-assurance__item" {{ block.shopify_attributes }}>
              <span class="ulveo-contact-assurance__icon">{% render 'ulveo-contact-icon', name: block.settings.icon %}</span>
              <div>
                <h3 class="ulveo-contact-assurance__title">{{ block.settings.title | escape }}</h3>
                {%- if block.settings.text != blank -%}
                  <p class="ulveo-contact-assurance__desc">{{ block.settings.text | escape }}</p>
                {%- endif -%}
                {%- if block.settings.link_label != blank and block.settings.link != blank -%}
                  <a class="ulveo-contact__text-link" href="{{ block.settings.link }}">{{ block.settings.link_label | escape }}</a>
                {%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </section>
  </div>
</div>

{% schema %}
{
  "name": "Contact — réassurance",
  "tag": "div",
  "class": "ulveo-contact-assurance-section",
  "max_blocks": 4,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Surtitre",
      "default": "Après votre achat aussi"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Une équipe à votre écoute"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte",
      "default": "<p>Chez Ulvéo, nous accordons autant d’importance à votre expérience après votre commande qu’avant votre achat.</p>"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Jeu de couleurs",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge haute",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge basse",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Engagement",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Pictogramme",
          "options": [
            { "value": "chat", "label": "Bulle" },
            { "value": "lock", "label": "Cadenas" },
            { "value": "truck", "label": "Camion" },
            { "value": "return", "label": "Retour" },
            { "value": "heart", "label": "Cœur" },
            { "value": "check", "label": "Validation" }
          ],
          "default": "chat"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titre",
          "default": "Engagement"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Texte"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Lien : texte"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Lien : destination"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Contact — réassurance"
    }
  ]
}
{% endschema %}
